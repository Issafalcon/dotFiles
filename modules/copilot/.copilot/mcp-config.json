{
  "mcpServers": {
    "nvim-mcp": {
      "command": "nvim-mcp",
      "args": ["--log-file", "/tmp/nvim-mcp.log", "--log-level", "debug", "--connect", "auto"],
      "env": {
        "XDG_RUNTIME_DIR": "/run/user/1000"
      }
    },
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@latest"],
      "tools": ["query-docs", "resolve-library-id"]
    }
  }
}
